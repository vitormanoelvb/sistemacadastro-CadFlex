      <SubComponents>
        <Component class="javax.swing.JTextArea" name="jtaCreditos">
          <Properties>
            <Property name="editable" type="boolean" editor="org.netbeans.modules.form.RADConnectionPropertyEditor">
              <Connection code="false" type="code"/>
            </Property>
            <Property name="columns" type="int" value="20"/>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="================== SISTEMA CADFLEX ==================&#xa; ====== SISTEMA ACAD&#xca;MICO DE CADASTRO FLEX&#xcd;VEL ======&#xa;=================================================&#xa;&#xa;Desenvolvido em Java com Programa&#xe7;&#xe3;o Orientada a Objetos (POO), &#xa;integrando conceitos modernos de estrutura de sistemas e interface gr&#xe1;fica.&#xa;&#xa;Funcionalidades Implementadas:&#xa;&#x2192; Tela de Login  &#xa;&#x2192; Tela de Registro  &#xa;&#x2192; Tela Principal de Menu  &#xa;&#x2192; Cadastro de Produtos (Incluir, Alterar, Excluir)  &#xa;&#x2192; Visualiza&#xe7;&#xe3;o de Cadastros  &#xa;&#x2192; Tela de Cr&#xe9;ditos  &#xa;&#x2192; Splash Screen com V&#xed;deo e Introdu&#xe7;&#xe3;o Visual  &#xa;&#x2192; Conex&#xe3;o com Banco de Dados (MySQL via JDBC)&#xa;&#xa;Estrutura T&#xe9;cnica:&#xa;&#x2192; Arquitetura parcial baseada em MVC  &#xa;&#x2192; Encapsulamento e Heran&#xe7;a  &#xa;&#x2192; Polimorfismo e Abstra&#xe7;&#xe3;o  &#xa;&#x2192; Uso de arquivos de m&#xed;dia (imagens e v&#xed;deo)  &#xa;&#x2192; Utiliza&#xe7;&#xe3;o de JFrames com interface Swing&#xa;&#xa;Desenvolvedor: Vitor Manoel Vidal Braz  &#xa;Sistema: CadFlex (Cadastro Flex&#xed;vel)  &#xa;Motor Gr&#xe1;fica: VM ENGINE DEVELOPMENT - v1.5  &#xa;Universidade: UNIVALE - Universidade Vale do Rio Doce  &#xa;Curso: Sistemas de Informa&#xe7;&#xe3;o - 3&#xba; Per&#xed;odo  &#xa;Disciplina: Programa&#xe7;&#xe3;o Orientada a Objetos (POO)  &#xa;&#xa;Agradecimento especial ao professor:  &#xa;Prof. Vitor Silva Ribeiro  &#xa;Pelo incentivo &#xe0; criatividade e ao aprendizado.&#xa;&#xa;&#xa9;vmengine2025 - Todos os direitos reservados"/>
            <Property name="wrapStyleWord" type="boolean" value="true"/>
            <Property name="cursor" type="java.awt.Cursor" editor="org.netbeans.modules.form.editors2.CursorEditor">
              <Color id="Text Cursor"/>
            </Property>
          </Properties>
        </Component>
      </SubComponents>
